+    def _fell(self):
+        """Same fall test goto has always used; sets mode='fallen'."""
+        p = self.data.xpos[self.torso]
+        z = self.data.xmat[self.torso].reshape(3, 3)[:, 2]
+        tilt = np.rad2deg(np.arccos(np.clip(z[2], -1, 1)))
