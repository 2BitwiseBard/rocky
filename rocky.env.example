# rocky.env.example — every machine setting the launcher and the code read, with its default.
#
#   cp rocky.env.example rocky.env      # rocky.env is git-ignored: your machine's values live there
#
# Then uncomment only what differs on your machine. ./rocky.sh sources rocky.env; Python started
# without rocky.sh (a cockpit under systemd-run, a bench, brain_install, pytest) reads the same file
# through sim/envfile.py. Either way a variable already set in the environment wins over the file.
# Format: plain KEY=value lines. Quote values with spaces; $HOME / ${VAR} and a leading ~ expand.
#
# The model ids below are the REFERENCE SETUP's: one laptop with a 16 GB GPU running llama-swap,
# measured in D055 (docs/BRAIN_MODELS_2026-09-24.md). Any OpenAI-compatible server works: set
# ROCKY_LLM_BASE_URL and pick models here or in the cockpit's pickers.

# ---- the LLM server (cockpit local / multimodal brains, rocky.sh brain, the benches) ----------------
# ROCKY_LLM_BASE_URL=http://127.0.0.1:8080/v1   # any OpenAI-compatible /v1 (default: llama-swap on :8080)
# ROCKY_LLM_API_KEY=                            # its bearer key, if it wants one (default: none)
# ROCKY_LLM_KEY_FILE=                           # or a file holding the key: a bare key, or KEY=value lines
#                                               # (its ROCKY_LLM_API_KEY=, else its first *_KEY=; a systemd
#                                               # environment.d file works as is)
# ROCKY_LLM_MODEL=qwen3.6-35b-a3b               # the model `rocky.sh brain` drives the robot with

# ---- model roles in the cockpit (a pick in the UI is saved to ROCKY_COCKPIT_CONF and wins) ---------
# ROCKY_BRAIN_MODEL=tool-model                  # text + tools (reference: a llama-swap selector -> qwen3.6-35b-a3b)
# ROCKY_VISION_MODEL=vision-model               # describes the eye (reference: a selector -> lfm2.5-vl)
# ROCKY_MULTIMODAL_MODEL=qwen3.5-9b             # sees the eye frame AND calls tools (brain mode 'multimodal')
# ROCKY_CLAUDE_MODEL=claude-sonnet-5            # brain mode 'claude' (needs the anthropic extra + ANTHROPIC_API_KEY)
# ROCKY_EMBED_MODEL=embedding                   # place recognition's text embeddings (reference: Qwen3-Embedding-0.6B)
# ROCKY_FALLBACK_BRAIN=qwen3.6-35b-a3b,qwen3.8-27b-iq4           # tried in order after the brain role
# ROCKY_FALLBACK_VISION=lfm2.5-vl,gemma-4-12b,gemma-4-26b-a4b    # after the vision role
# ROCKY_FALLBACK_MULTIMODAL=qwen3.5-9b,qwen3.5-4b,gemma-4-12b    # after the multimodal role
# ROCKY_QUARANTINED=                            # model ids never used, whatever is picked (e.g. ones that fault your GPU)
# ROCKY_CORESIDENT=                             # "brain-id,vision-id" that fit the GPU together: the UI warns about
#                                               # any other pair and the benches never unload them (default: no check)
# ROCKY_THINKING_MODELS=                        # model ids that keep their thinking mode on (default: off for all)
# ROCKY_FAMILY_NOTES=1                          # 0 = no per-family prompt notes (D055a)
# ROCKY_STOP_FIRST=1                            # 0 = stop lines go to the model too (brain_bench sets it for its cockpit)
# ANTHROPIC_API_KEY=                            # the cockpit's 'claude' brain mode (pip install -e ".[cockpit]")

# ---- speech -----------------------------------------------------------------------------------------
# ROCKY_WHISPER_URL=http://127.0.0.1:8082       # whisper server with /v1/audio/transcriptions (cockpit, rocky.sh voice)
# ROCKY_WHISPER_FAST_URL=                       # a faster one `rocky.sh cockpit` prefers when it answers (default: none)
# ROCKY_VOICE_SECS=4                            # rocky.sh voice: seconds recorded per Enter
# ROCKY_VOICE_WAV=                              # rocky.sh voice: send this wav instead of the mic (tests)

# ---- the cockpit ------------------------------------------------------------------------------------
# ROCKY_COCKPIT_PORT=8765                       # its port (binds 127.0.0.1); the benches refuse to drive this one
# ROCKY_COCKPIT_CONF=~/.config/rocky/cockpit.json   # where the model roles are saved
# ROCKY_COCKPIT_HOSTS=                          # extra Host names it answers to (comma-separated; loopback, *.ts.net
#                                               # and this machine's hostname always pass)
# ROCKY_COCKPIT_URL=http://127.0.0.1:8765       # the MCP server's cockpit (ROCKY_BACKEND=auto|cockpit)
# ROCKY_TAILNET_PORT=9445                       # rocky.sh tailnet: the https port `tailscale serve` publishes
# ROCKY_AWARENESS_S=20                          # how often the cockpit composes its situation line, s
# ROCKY_MEMORY_DIR=                             # scene + place memory (default sim/out/memory, git-ignored)
# ROCKY_GESTURE_DIR=                            # gesture library (default gait/gestures)

# ---- brain-install / brain-bench (llama-swap only) ---------------------------------------------------
# ROCKY_MODELS_DIR=~/models                     # one folder per model id
# ROCKY_DOWNLOADS_DIR=~/Downloads               # where brain-install looks for new *.gguf
# ROCKY_SWAP_CONFIG=~/.config/llama-swap/config.yaml
# ROCKY_SWAP_MANIFEST=~/.config/llama-swap/models.manifest.json   # the restore manifest ({"models": [...]})
# ROCKY_GPU_VRAM_GB=16                          # brain-install warns when weights + projector exceed this - 2 GB
# ROCKY_HF_BIN=~/.local/bin/hf                  # the Hugging Face CLI that fetches a missing mmproj

# ---- per run, not per machine: set these on the command line, not here ------------------------------
# (rocky.env reaches every Python process that imports the cockpit's brains, pytest included.)
#   ROCKY_WORLD=flat|room|cliff   ROCKY_VIEWER=1|0   ROCKY_AUDIO=1|0   MUJOCO_GL=glfw|egl|osmesa|disable
#   ROCKY_BACKEND=mock|sim|cockpit|auto            (the MCP server's backend; .mcp.json sets it)
#   ROCKY_REPO=<checkout>   ROCKY_ENV_FILE=<another rocky.env; /dev/null = none>
#   ROCKY_MCP_LIVE=0                               (MCP: read the tool lists once, no watcher)
#   ROCKY_EXPERIMENTS_OUT=<dir>                    (sim/experiments: results + clips there, not in the record)
#   ROCKY_D056_SNAPSHOTS=<dir>                     (tests: another D056 snapshot dir than harness/fixtures/d056)
