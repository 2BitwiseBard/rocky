# Project ROCKY — binary / regenerated artefacts go to git-lfs.
# The CAD loop (caliper numbers -> params.yaml -> regen) rewrites every
# STL/STEP/PNG in cad/out, so keeping them out of the git object store
# is what stops the history from ballooning on each pass.

*.stl   filter=lfs diff=lfs merge=lfs -text
*.step  filter=lfs diff=lfs merge=lfs -text
*.stp   filter=lfs diff=lfs merge=lfs -text
*.3mf   filter=lfs diff=lfs merge=lfs -text
*.png   filter=lfs diff=lfs merge=lfs -text
*.jpg   filter=lfs diff=lfs merge=lfs -text
*.gif   filter=lfs diff=lfs merge=lfs -text
*.wav   filter=lfs diff=lfs merge=lfs -text
*.mp4   filter=lfs diff=lfs merge=lfs -text
*.npz   filter=lfs diff=lfs merge=lfs -text
*.pt    filter=lfs diff=lfs merge=lfs -text
*.pdf   filter=lfs diff=lfs merge=lfs -text
*.gcode filter=lfs diff=lfs merge=lfs -text

# 26 MB single-file viewer, regenerated with the CAD pass
cad/pebble_viewer.html filter=lfs diff=lfs merge=lfs -text
rocky_v0.8.0_code/rocky/cad/pebble_viewer.html filter=lfs diff=lfs merge=lfs -text

# Text that must stay text
*.md    text
*.py    text
*.yaml  text
*.yml   text
*.json  text
*.jpg   filter=lfs diff=lfs merge=lfs -text
*.pdf   filter=lfs diff=lfs merge=lfs -text
