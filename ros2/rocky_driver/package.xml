<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rocky_driver</name>
  <version>0.1.0</version>
  <description>Feetech bus hardware interface: Python bridge (hw:=topic) + C++ plugin skeleton (hw:=serial)</description>
  <maintainer email="tbensko@gmail.com">Tyler Bensko</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>rocky_msgs</exec_depend>

  <export><build_type>ament_cmake</build_type></export>
</package>
