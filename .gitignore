# --- Python environments and caches ---
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
.ipynb_checkpoints/

# --- bench outputs (calibration is per-robot, written on bench day; --mock rehearsals
#     write bench/out/mock/, never beside the real files) ---
bench/out/
bench/calibration.yaml

# --- local machine config (the .example is the portable one) ---
.mcp.json
rocky.env
.claude/settings.local.json

# --- OS noise ---
.DS_Store
*.swp

# --- RL smoke / scratch runs (real runs are committed on purpose, git-lfs) ---
sim/runs/_*/
sim/runs/smoke_*/
# --- the playground's `record` clip ---
sim/playground_clip.mp4

# playwright MCP scratch (screenshots, snapshots)
.playwright-mcp/
MUJOCO_LOG.TXT

# scene memory (sim/scene_memory.py): per-machine robot memory, not source
sim/out/memory/

# cockpit recordings (sim/cockpit.py REC_DIR): per machine, like the scene memory
sim/out/recordings/

# sim outputs: experiment clips + temp mux files (sim/experiments/exp_paths.py OUT) and
# run_sim's clip + contact sheet (`run_sim.py --out sim`, which refreshes the committed
# sim/pebble_sim.mp4, also writes the sheet beside it)
sim/experiments/out/
sim/out/run_sim/
sim/sim_contact_sheet.png

# perception logs (wifi_rssi_logger.py: the --scan log and the --sim demo log)
perception/out/

# --- packaging and tool caches ---
build/
dist/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# personal to-do lists kept beside the checkout; the repo stays generic
OWNER_TODO*.md
TONIGHT*.md
